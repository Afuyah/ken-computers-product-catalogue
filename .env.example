# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Database -------------------------------------------------------------
# Local development (default when unset): sqlite:///instance/catalogue.db
# Railway gives you a URL like postgresql://postgres:...@host:port/railway
DATABASE_URL=

# --- Where the site lives -------------------------------------------------
SITE_NAME=Ken Computers MSA
SITE_URL=https://kencomputersmsa.com
CONTACT_WHATSAPP=254700000000
CONTACT_PHONE=+254 700 000 000
CONTACT_EMAIL=sales@kencomputersmsa.com
CONTACT_LOCATION=Mombasa, Kenya

# --- Media storage --------------------------------------------------------
# local = write to MEDIA_ROOT (development only)
# r2    = Cloudflare R2 (production)
STORAGE_BACKEND=local
MEDIA_ROOT=./media

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=kencomputers-media
# Public hostname attached to the bucket, e.g. https://cdn.kencomputersmsa.com
CDN_BASE_URL=

# --- Uploads --------------------------------------------------------------
MAX_UPLOAD_MB=25
IMAGE_WIDTHS=400,800,1600
